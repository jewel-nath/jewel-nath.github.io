---
// One turn of a 2D LiDAR around a mecanum robot, drawn the way RViz shows a laser scan.
---

<figure class="scan">
  <canvas
    class="scan__canvas"
    role="img"
    aria-label="Illustration of a LiDAR scan: a small four-wheeled robot in the middle of a room, with dots tracing the walls, a doorway, a sofa, a cabinet, a chair and the legs of a table."
  ></canvas>
  <figcaption class="scan__caption">
    <span>An illustration of one turn of a LiDAR, one dot per laser hit. OrbiBot V1 maps rooms from scans like this.</span>
    <button type="button" class="scan__again">Scan again</button>
  </figcaption>
</figure>

<script>
  type Segment = [number, number, number, number];
  type Circle = [number, number, number];
  type Point = { angle: number; x: number; y: number };

  const TAU = Math.PI * 2;
  const TURN_MS = 2600;
  const FADE_MS = 600;
  const MAX_RANGE = 8;

  const box = (x0: number, y0: number, x1: number, y1: number): Segment[] => [
    [x0, y0, x1, y0],
    [x1, y0, x1, y1],
    [x1, y1, x0, y1],
    [x0, y1, x0, y0],
  ];

  // The room in metres, with the robot at the origin facing +x. The gap in the lower wall is a door.
  const segments: Segment[] = [
    [-2.6, -1.8, 0.6, -1.8],
    [1.5, -1.8, 3.4, -1.8],
    [3.4, -1.8, 3.4, 1.2],
    [3.4, 1.2, 1.6, 1.2],
    [1.6, 1.2, 1.6, 2.6],
    [1.6, 2.6, -2.6, 2.6],
    [-2.6, 2.6, -2.6, -1.8],
    [-0.4, -3.0, 2.6, -3.0],
    ...box(-2.5, 1.65, -0.9, 2.5),
    ...box(-2.5, -1.7, -1.95, -0.95),
    ...box(0.85, 1.75, 1.3, 2.2),
  ];
  const tableLegs: Circle[] = [
    [1.9, -1.0, 0.035],
    [2.8, -1.0, 0.035],
    [1.9, -0.25, 0.035],
    [2.8, -0.25, 0.035],
  ];
  const view = { minX: -3.0, maxX: 3.8, minY: -3.4, maxY: 3.0 };

  // A seeded generator, so the scan looks the same on every visit.
  function random(seed: number) {
    return () => {
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function castRay(dx: number, dy: number): number {
    let nearest = Infinity;
    for (const [ax, ay, bx, by] of segments) {
      const ex = bx - ax;
      const ey = by - ay;
      const denominator = dx * ey - dy * ex;
      if (Math.abs(denominator) < 1e-9) continue;
      const t = (ax * ey - ay * ex) / denominator;
      const u = (ax * dy - ay * dx) / denominator;
      if (t > 0.05 && u >= 0 && u <= 1 && t < nearest) nearest = t;
    }
    for (const [cx, cy, r] of tableLegs) {
      const b = -(dx * cx + dy * cy);
      const c = cx * cx + cy * cy - r * r;
      const discriminant = b * b - c;
      if (discriminant < 0) continue;
      const t = -b - Math.sqrt(discriminant);
      if (t > 0.05 && t < nearest) nearest = t;
    }
    return nearest;
  }

  function scanRoom(): Point[] {
    const next = random(7);
    const gaussian = () => Math.sqrt(-2 * Math.log(1 - next())) * Math.cos(TAU * next());
    const points: Point[] = [];
    const rays = 720;
    for (let i = 0; i < rays; i++) {
      const angle = (i / rays) * TAU;
      const dx = Math.cos(angle);
      const dy = Math.sin(angle);
      const range = castRay(dx, dy);
      if (range > MAX_RANGE || next() < 0.04) continue;
      const measured = range + gaussian() * (0.008 + range * 0.004);
      points.push({ angle, x: dx * measured, y: dy * measured });
    }
    return points;
  }

  function hexToRgb(hex: string): [number, number, number] {
    const value = hex.trim().replace('#', '');
    const n = parseInt(value.length === 3 ? [...value].map((c) => c + c).join('') : value, 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }

  for (const figure of document.querySelectorAll<HTMLElement>('.scan')) {
    const canvas = figure.querySelector('canvas')!;
    const again = figure.querySelector<HTMLButtonElement>('.scan__again')!;
    const context = canvas.getContext('2d')!;
    const points = scanRoom();
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const darkScheme = matchMedia('(prefers-color-scheme: dark)');

    let colors = { ink: '#000', paper: '#fff', rule: '#ccc', signal: [242, 92, 5] as [number, number, number] };
    let scale = 1;
    let originX = 0;
    let originY = 0;
    let dpr = 1;
    let sweep = reduceMotion.matches ? TAU : 0;
    let beam = 0;
    let frame = 0;

    const readColors = () => {
      const style = getComputedStyle(canvas);
      colors = {
        ink: style.getPropertyValue('--ink').trim(),
        paper: style.getPropertyValue('--paper').trim(),
        rule: style.getPropertyValue('--rule').trim(),
        signal: hexToRgb(style.getPropertyValue('--signal')),
      };
    };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(canvas.clientWidth * dpr);
      canvas.height = Math.round(canvas.clientHeight * dpr);
      const spanX = view.maxX - view.minX;
      const spanY = view.maxY - view.minY;
      scale = Math.min(canvas.width / spanX, canvas.height / spanY);
      originX = (canvas.width - spanX * scale) / 2 - view.minX * scale;
      originY = (canvas.height - spanY * scale) / 2 + view.maxY * scale;
    };

    const toCanvas = (x: number, y: number): [number, number] => [originX + x * scale, originY - y * scale];

    const drawRobot = () => {
      const m = scale;
      context.save();
      context.translate(originX, originY);
      context.fillStyle = colors.ink;
      for (const [wx, wy] of [
        [0.16, 0.2],
        [-0.16, 0.2],
        [0.16, -0.2],
        [-0.16, -0.2],
      ]) {
        context.fillRect((wx - 0.055) * m, (-wy - 0.028) * m, 0.11 * m, 0.056 * m);
      }
      context.fillRect(-0.22 * m, -0.17 * m, 0.44 * m, 0.34 * m);
      context.fillStyle = colors.paper;
      context.beginPath();
      context.arc(0.06 * m, 0, 0.065 * m, 0, TAU);
      context.fill();
      context.restore();
    };

    const draw = () => {
      const { width, height } = canvas;
      const [r, g, b] = colors.signal;
      context.clearRect(0, 0, width, height);

      context.strokeStyle = colors.rule;
      context.lineWidth = Math.max(1, dpr * 0.75);
      context.beginPath();
      for (let x = Math.ceil(view.minX); x <= view.maxX; x++) {
        const [px] = toCanvas(x, 0);
        context.moveTo(px, 0);
        context.lineTo(px, height);
      }
      for (let y = Math.ceil(view.minY); y <= view.maxY; y++) {
        const [, py] = toCanvas(0, y);
        context.moveTo(0, py);
        context.lineTo(width, py);
      }
      context.stroke();

      if (beam > 0) {
        const radius = Math.hypot(width, height);
        if ('createConicGradient' in context) {
          // Canvas angles turn clockwise, so the swept wedge sits just after -sweep.
          const wedge = context.createConicGradient(-sweep, originX, originY);
          wedge.addColorStop(0, `rgb(${r} ${g} ${b} / ${0.3 * beam})`);
          wedge.addColorStop(0.09, `rgb(${r} ${g} ${b} / 0)`);
          wedge.addColorStop(1, `rgb(${r} ${g} ${b} / 0)`);
          context.fillStyle = wedge;
          context.fillRect(0, 0, width, height);
        }
        context.strokeStyle = `rgb(${r} ${g} ${b} / ${0.75 * beam})`;
        context.lineWidth = 1.25 * dpr;
        context.beginPath();
        context.moveTo(originX, originY);
        context.lineTo(originX + Math.cos(sweep) * radius, originY - Math.sin(sweep) * radius);
        context.stroke();
      }

      context.fillStyle = `rgb(${r} ${g} ${b})`;
      const size = Math.max(2, 2.4 * dpr);
      for (const point of points) {
        if (point.angle > sweep) break;
        const [px, py] = toCanvas(point.x, point.y);
        context.fillRect(px - size / 2, py - size / 2, size, size);
      }

      drawRobot();
    };

    const play = () => {
      cancelAnimationFrame(frame);
      if (reduceMotion.matches) {
        sweep = TAU;
        beam = 0;
        draw();
        return;
      }
      const start = performance.now();
      const step = (now: number) => {
        const elapsed = now - start;
        sweep = Math.min(TAU, (elapsed / TURN_MS) * TAU);
        beam = elapsed < TURN_MS ? 1 : Math.max(0, 1 - (elapsed - TURN_MS) / FADE_MS);
        draw();
        if (beam > 0) frame = requestAnimationFrame(step);
      };
      frame = requestAnimationFrame(step);
    };

    readColors();
    resize();
    draw();

    new ResizeObserver(() => {
      resize();
      draw();
    }).observe(canvas);

    darkScheme.addEventListener('change', () => {
      readColors();
      draw();
    });

    again.addEventListener('click', play);

    // Start the first turn once the scan is on screen.
    const watcher = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          watcher.disconnect();
          play();
        }
      },
      { threshold: 0.4 },
    );
    watcher.observe(canvas);
  }
</script>

<style>
  .scan {
    margin: 0;
  }

  .scan__canvas {
    display: block;
    width: 100%;
    aspect-ratio: 1;
  }

  .scan__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    margin-top: 0.75rem;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .scan__caption span {
    max-width: 34ch;
  }

  .scan__again {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .scan__again:hover {
    border-color: var(--signal);
  }
</style>
