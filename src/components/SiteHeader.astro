---
import { cv } from '../data/site';

// On the home page the section links scroll; elsewhere they lead back to it.
const onHome = Astro.url.pathname === '/';
const base = onHome ? '' : '/';
const links = [
  { label: 'Work', href: `${base}#work`, section: 'work' },
  { label: 'Reports', href: `${base}#reports`, section: 'reports' },
  { label: 'Experience', href: `${base}#experience`, section: 'experience' },
];
---

<header class="top">
  <div class="wrap top__row">
    <a class="brand" href="/" aria-label="Jewel Nath, home">
      <span class="brand__mark" aria-hidden="true">JN</span>Jewel Nath
    </a>
    <nav class="nav" id="nav" aria-label="Main">
      {links.map((link) => <a href={link.href} data-section={onHome ? link.section : undefined}>{link.label}</a>)}
      <a href={cv.href}>CV</a>
    </nav>
    <button class="icon-btn menu-btn" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="nav">
      <svg class="ico"><use href="#i-menu"></use></svg>
    </button>
    <button class="icon-btn" id="theme-btn" aria-label="Switch between light and dark">
      <svg class="ico theme-sun"><use href="#i-sun"></use></svg>
      <svg class="ico theme-moon"><use href="#i-moon"></use></svg>
    </button>
  </div>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 74%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .top__row {
    display: flex;
    align-items: center;
    height: 66px;
    gap: 12px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 600 17px var(--brand);
    letter-spacing: -0.02em;
    color: var(--heading);
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand__mark {
    width: 28px;
    height: 28px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--on-accent);
    background: linear-gradient(135deg, var(--accent-hi), var(--accent));
    box-shadow: var(--glow);
  }

  .nav {
    margin-left: auto;
    display: flex;
    gap: 2px;
    padding: 4px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--card);
  }

  .nav a {
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    padding: 6px 15px;
    border-radius: 999px;
    transition:
      color 0.15s,
      background 0.15s;
  }

  .nav a:hover {
    color: var(--heading);
    text-decoration: none;
  }

  .nav a:global(.on) {
    color: var(--heading);
    background: var(--card-2);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--heading);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition:
      border-color 0.15s,
      color 0.15s;
  }

  .icon-btn:hover {
    border-color: var(--accent-line);
    color: var(--accent);
  }

  .menu-btn {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-moon,
  :global(:root[data-theme='light']) .theme-sun {
    display: none;
  }

  @media (max-width: 780px) {
    .nav {
      display: none;
    }

    .menu-btn {
      display: grid;
      margin-left: auto;
    }

    .nav:global(.open) {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 74px;
      left: 16px;
      right: 16px;
      padding: 8px;
      border-radius: 18px;
      box-shadow: var(--card-shadow);
    }

    .nav:global(.open) a {
      font-size: 16px;
      padding: 12px 14px;
      border-radius: 12px;
    }
  }
</style>
