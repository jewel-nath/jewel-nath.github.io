---
import type { Skill } from '../data/site';

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;
---

<dl class="skills">
  {
    skills.map((skill) => (
      <div>
        <dt>{skill.area}</dt>
        <dd>
          {skill.skills}
          <span class="skills__shown">
            Shown in: {skill.href ? <a href={skill.href}>{skill.shownIn}</a> : skill.shownIn}
          </span>
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .skills {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 40px;
    margin: 0;
  }

  .skills div {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--border);
  }

  dt {
    font-weight: 600;
    color: var(--heading);
    font-size: 15px;
  }

  dd {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
  }

  .skills__shown {
    display: block;
    margin-top: 4px;
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .skills {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .skills div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
