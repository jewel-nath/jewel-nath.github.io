---
import { Picture } from 'astro:assets';
import type { Project } from '../data/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="entry">
  <h3 class="entry__name">{project.name}</h3>
  <div class="entry__meta">
    <p class="status" data-status={project.status}>{project.statusLabel}</p>
    <p>{project.context}</p>
    <p class="entry__years">{project.years}</p>
    <ul class="entry__links">
      {project.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </div>
  <div class="entry__body">
    <p>{project.summary}</p>
    <p class="entry__stack">Made with {project.stack}.</p>
    {
      project.image && (
        <Picture
          src={project.image.src}
          alt={project.image.alt}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(min-width: 64rem) 46rem, 100vw"
          class="entry__photo"
        />
      )
    }
  </div>
</article>

<style>
  .entry {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) minmax(0, 3fr);
    grid-template-areas:
      'meta name'
      'meta body';
    align-items: start;
    column-gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: 2rem 2.75rem;
    border-top: 1px solid var(--rule);
  }

  .entry__name {
    grid-area: name;
  }

  .entry__meta {
    grid-area: meta;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .entry__body {
    grid-area: body;
  }

  .entry__meta p,
  .entry__meta ul {
    margin: 0 0 0.4rem;
  }

  .entry__meta .entry__links {
    margin-top: 0.9rem;
  }

  .entry__years {
    font-variant-numeric: tabular-nums;
  }

  .entry__links {
    padding: 0;
    list-style: none;
  }

  .entry__links a {
    display: inline-block;
    padding-block: 0.3rem;
    color: var(--ink);
    font-weight: 600;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5em;
    color: var(--ink);
    font-weight: 650;
  }

  /* Filled: it exists and runs. A ring: designed or simulated only. */
  .status::before {
    content: '';
    flex: none;
    width: 0.62em;
    height: 0.62em;
    border-radius: 50%;
    background: var(--signal);
  }

  .status[data-status='designed']::before,
  .status[data-status='simulated']::before {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--signal);
  }

  .entry__name {
    margin: 0 0 0.75rem;
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    font-weight: 750;
    font-stretch: 112%;
    line-height: 1.15;
  }

  .entry__body > p {
    max-width: var(--measure);
    margin: 0 0 0.75rem;
  }

  .entry__stack {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .entry__body :global(.entry__photo) {
    width: 100%;
    max-width: 46rem;
    margin-top: 1.5rem;
    border-radius: 3px;
  }

  @media (max-width: 48rem) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'name' 'meta' 'body';
    }

    /* On a phone the meta reads as one line under the name. */
    .entry__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.2rem 1rem;
      margin-bottom: 0.75rem;
    }

    .entry__meta p,
    .entry__meta ul,
    .entry__meta .entry__links {
      margin: 0;
    }

    .entry__links {
      display: flex;
      flex-wrap: wrap;
      gap: 0 1rem;
    }
  }
</style>
