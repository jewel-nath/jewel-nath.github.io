---
// The report (or, for a project without one, the code), and the closing card that leads to the next project.
import { reports } from '../../data/site';
import ReportCard from '../ReportCard.astro';

interface Props {
  // The report's DOI. Leave it out for a project without a report: the page then ends with its code.
  doi?: string;
  // One line on the report (its pages, its figures, how it was checked), or on the code.
  about: string;
  code: { href: string; label: string };
  next: { title: string; text: string; href: string; label: string };
}

const { doi, about, code, next } = Astro.props;
const report = doi ? reports.find((r) => r.doi === doi) : undefined;
if (doi && !report) throw new Error(`No report with DOI ${doi} in src/data/site.ts`);
---

{
  report ? (
    <section class="section" id="report" aria-labelledby="report-h">
      <div class="sec-head" data-reveal>
        <p class="label">The report</p>
        <h2 id="report-h">Read the full design</h2>
        <p>{about}</p>
      </div>
      <ReportCard report={report} />
      <p class="code-link">
        <a href={code.href}>{code.label} →</a>
      </p>
    </section>
  ) : (
    <section class="section" id="code" aria-labelledby="code-h">
      <div class="sec-head" data-reveal>
        <p class="label">The code</p>
        <h2 id="code-h">Read the code</h2>
        <p>{about}</p>
      </div>
      <p class="code-link" data-reveal>
        <a href={code.href}>{code.label} →</a>
      </p>
    </section>
  )
}

<section class="cta" aria-labelledby="cta-h" data-reveal>
  <h2 id="cta-h">Next: {next.title}</h2>
  <p>{next.text}</p>
  <div class="actions">
    <a class="btn primary" href={next.href}>{next.label}<svg class="ico"><use href="#i-arrow"></use></svg></a>
    <a class="btn" href="/#work">All the work</a>
  </div>
</section>
