---
import { Image } from 'astro:assets';
import ClipGallery from '../components/ClipGallery.astro';
import HowOverview from '../components/project/HowOverview.astro';
import Lessons from '../components/project/Lessons.astro';
import PhotoTimeline from '../components/project/PhotoTimeline.astro';
import ProjectEnd from '../components/project/ProjectEnd.astro';
import ProjectIntro from '../components/project/ProjectIntro.astro';
import TeamCredits from '../components/project/TeamCredits.astro';
import Topics from '../components/project/Topics.astro';
import { build, demos, how, intro, lessons, report, shows, team } from '../data/robot-niko';
import Base from '../layouts/Base.astro';
import '../styles/project.css';

const sections = [
  { id: 'video', label: 'In video' },
  { id: 'build', label: 'The build' },
  { id: 'how', label: 'How it works' },
  { id: 'team', label: 'The team' },
  { id: 'report', label: 'The report' },
];
---

<Base title="Robot Niko: a life-size humanoid assistant · Jewel Nath" description={intro.lead}>
  <div class="project">
    <ProjectIntro intro={intro} sections={sections} shows={shows} />

    <section class="section" id="video" aria-labelledby="video-h">
      <div class="sec-head" data-reveal>
        <p class="label">In video · December 2022</p>
        <h2 id="video-h">Niko working</h2>
        <p>Recorded at the FabLab in the days around its launch, with sound.</p>
      </div>

      <div class="demos">
        {
          demos.map((item, i) => (
            <figure class:list={['demo', { 'demo--lead': i === 0 }]} data-reveal>
              <div class="demo__frame">
                <video controls playsinline preload="none" poster={item.poster} aria-label={item.label}>
                  <source src={item.src} type="video/mp4" />
                </video>
              </div>
              <figcaption>
                <p class="when num">
                  {item.when} · {item.length}
                </p>
                <p class="demo__cap">{item.caption}</p>
                {
                  item.youtube && (
                    <a class="demo__yt" href={item.youtube}>
                      <svg class="ico">
                        <use href="#i-yt" />
                      </svg>
                      On YouTube
                    </a>
                  )
                }
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="section" id="build" aria-labelledby="build-h">
      <div class="sec-head" data-reveal>
        <p class="label">Built · Aug – Dec 2022</p>
        <h2 id="build-h">From a 3D model to a life-size robot</h2>
        <p>{build.text}</p>
      </div>

      <div class="build-hero" data-reveal>
        {
          build.hero.map((photo, i) => (
            <button class="tile" data-full={photo.src.src} data-cap={photo.caption}>
              <Image src={photo.src} alt={photo.alt} width={i === 0 ? 960 : 540} densities={[1, 2]} loading="eager" />
              <span class="cap">
                <span>{photo.caption}</span>
              </span>
            </button>
          ))
        }
      </div>

      <h3 class="sub" data-reveal>The build, in photos</h3>
      <PhotoTimeline photos={build.timeline} />

      <div class="build-more">
        <ClipGallery groups={build.clips} />
        <figure class="build-figure" data-reveal>
          <h4>The year in one figure</h4>
          <button class="tile tile--paper" data-full={build.timelineFigure.src.src} data-cap={build.timelineFigure.caption}>
            <Image src={build.timelineFigure.src} alt={build.timelineFigure.alt} width={720} densities={[1, 2]} />
          </button>
          <figcaption>{build.timelineFigure.caption}</figcaption>
        </figure>
      </div>
    </section>

    <section class="section" id="how" aria-labelledby="how-h">
      <div class="sec-head" data-reveal>
        <p class="label">How it works</p>
        <h2 id="how-h">One Raspberry Pi, 27 servos, a voice and a camera</h2>
        <p>{how.text}</p>
      </div>

      <HowOverview facts={how.facts} overview={how.overview} label="The whole robot" />

      <Topics topics={how.topics} />
    </section>

    <section class="section" id="team" aria-labelledby="team-h">
      <div class="sec-head" data-reveal>
        <p class="label">My part, and the team</p>
        <h2 id="team-h">Built by Quanta Robotics</h2>
      </div>

      <TeamCredits team={team} />
      <Lessons lessons={lessons} />
    </section>

    <ProjectEnd
      doi={report.doi}
      about="15 pages and 13 diagrams, checked against the code, its history and the dated photos and videos, with the team as co-authors."
      code={{ href: report.code, label: "Niko's code and documentation on GitHub" }}
      next={{
        title: 'EnviroBot',
        text: 'A rover with a six-servo arm that finds waste with a camera and picks it up, built with my team in 2024.',
        href: '/envirobot',
        label: 'See EnviroBot',
      }}
    />
  </div>
</Base>

<style>
  /* Videos with sound: the first large, the rest two by two. */
  .demos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 22px;
  }

  .demo--lead {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr);
    gap: 22px;
    align-items: end;
  }

  .demo__frame {
    border-radius: 14px;
    overflow: hidden;
    background: #000;
    aspect-ratio: 16 / 9;
    box-shadow: var(--photo-shadow);
  }

  .demo video {
    width: 100%;
    height: 100%;
    display: block;
  }

  .demo figcaption {
    margin-top: 12px;
  }

  .demo--lead figcaption {
    margin: 0;
  }

  .demo__cap {
    color: var(--heading);
    font-size: 15.5px;
    margin: 2px 0 8px;
  }

  .demo--lead .demo__cap {
    font: 400 24px/1.3 var(--display);
  }


  .demo__yt {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    font-size: 13.5px;
    font-weight: 500;
  }

  .demo__yt .ico {
    width: 15px;
    height: 15px;
  }

  /* The finished robot: a wide photo and an upright one at the same height. */
  .build-hero {
    display: grid;
    grid-template-columns: minmax(0, 16fr) minmax(0, 9fr);
    gap: 16px;
  }

  .build-hero .tile:first-child {
    aspect-ratio: 4 / 3;
  }

  .build-hero .tile:last-child {
    aspect-ratio: 3 / 4;
  }

  .build-more {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 28px;
    margin-top: 48px;
    align-items: start;
  }

  .build-more :global(.clips__grid) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .build-figure h4 {
    font: 600 15px var(--sans);
    color: var(--heading);
    margin-bottom: 14px;
  }

  @media (max-width: 860px) {
    .demo--lead,
    .build-more {
      grid-template-columns: 1fr;
    }

    .demo--lead figcaption {
      margin-top: 4px;
    }
  }

  @media (max-width: 620px) {
    .demos {
      grid-template-columns: 1fr;
    }

    .demo--lead .demo__cap {
      font-size: 20px;
    }
  }
</style>
